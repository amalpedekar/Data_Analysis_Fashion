  {
   "cell_type": "markdown",
   "id": "e5791a2f-6d47-4c27-8412-5a1069e3f375",
   "metadata": {},
   "source": [
    "-Apply Time Series Decomposition to Visualize Trend and Seasonality in Purchase Volume"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "d2d4c836-de89-4cd1-9e9a-d06b5f8449b3",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "purchase_date\n",
       "2024-08-31    34\n",
       "2024-09-30    58\n",
       "2024-10-31    46\n",
       "2024-11-30    40\n",
       "2024-12-31    41\n",
       "Freq: ME, dtype: int64"
      ]
     },
     "execution_count": 12,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# ensuring the index is in datetime format\n",
    "df.index = pd.to_datetime(df.index)\n",
    "\n",
    "# creating monthly purchase volume\n",
    "purchase_volume = df.resample('ME').size()\n",
    "\n",
    "# viewing the first few rows\n",
    "purchase_volume.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "df80296f-5e6d-4840-a295-229218180ea4",
   "metadata": {},
   "outputs": [],
   "source": [
    "import statsmodels.api as sm\n",
    "\n",
    "# decomposing the purchase volume time series\n",
    "purchase_decomp = sm.tsa.seasonal_decompose(\n",
    "    purchase_volume,\n",
    "    model='additive',\n",
    "    period=3\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "ee9773fe-8b51-457b-96e1-54da458ba42e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "trend_df = pd.DataFrame({\n",
    "    'Purchase Volume Trend': purchase_decomp.trend\n",
    "})\n",
    "\n",
    "trend_df.plot(figsize=(15,6))\n",
    "plt.title('Trend Component of Purchase Volume')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Purchase Volume')\n",
    "plt.show()"
   ]
  },
